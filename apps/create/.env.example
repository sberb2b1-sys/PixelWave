# Copy to apps/create/.env (local) or /etc/pixelwave-api.env (VPS)

HOST=127.0.0.1
PORT=3001
APP_URL=http://127.0.0.1:5173

# Supabase — required for POST /api/owner/users (owner panel create account)
SUPABASE_URL=http://supabase.pixelwaverf.ru
# Same as VITE_SUPABASE_URL is OK:
# SUPABASE_URL=${VITE_SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_jwt_here

# Browser key (never put service role in VITE_*)
VITE_SUPABASE_URL=http://supabase.pixelwaverf.ru
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

NOTIFY_EMAIL=info@pixelwaverf.ru
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@pixelwaverf.ru
SMTP_PASS=
SMTP_FROM=info@pixelwaverf.ru
