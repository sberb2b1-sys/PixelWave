# Copy to /etc/pixelwave-api.env on the server and set real values.
# Then in pixelwave-api.service: EnvironmentFile=/etc/pixelwave-api.env

NOTIFY_EMAIL=info@pixelwaverf.ru
SMTP_HOST=smtp.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@pixelwaverf.ru
SMTP_PASS=your-mailbox-password
SMTP_FROM=info@pixelwaverf.ru
