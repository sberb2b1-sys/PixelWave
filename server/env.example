# Copy to /etc/pixelwave-api.env on the server and set real values.
# Then in pixelwave-api.service: EnvironmentFile=/etc/pixelwave-api.env

HOST=127.0.0.1
PORT=3001
NODE_ENV=production
APP_URL=https://create.ae-it.ru

# Required for owner panel: create full Auth users
SUPABASE_URL=http://127.0.0.1:8001
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

NOTIFY_EMAIL=info@pixelwaverf.ru
SMTP_HOST=smtp.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@pixelwaverf.ru
SMTP_PASS=your-mailbox-password
SMTP_FROM=info@pixelwaverf.ru

RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
