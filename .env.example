# Local development — copy to .env and fill in values
# cp .env.example .env

# Self-hosted Supabase (Kong)
VITE_SUPABASE_URL=http://supabase.pixelwaverf.ru
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Server-only (Node API :3001) — NEVER expose in VITE_*
SUPABASE_URL=http://supabase.pixelwaverf.ru
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_jwt_here

HOST=127.0.0.1
PORT=3001
APP_URL=http://127.0.0.1:5173

NOTIFY_EMAIL=info@pixelwaverf.ru
